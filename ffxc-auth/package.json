{
  "name": "ffxc-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Licensing/web-auth backend for the Vortex Arena (YABAOCHEAT) client.",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/server.js",
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "mint": "node --import tsx scripts/mint-keys.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
