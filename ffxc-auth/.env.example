# Copy to .env and fill in. Loaded with `node --env-file=.env`.

# --- transport -------------------------------------------------------------
HOST=0.0.0.0
PORT=8787

# Bearer token for the admin panel/REST. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me

# --- signing ---------------------------------------------------------------
# Ed25519 PKCS8 PEM produced by `npm run mint`. Keep it off the repo.
PRIVATE_KEY_PATH=keys/private.pem

# --- wire contract (must match ProtocolConstants.swift) --------------------
PRODUCT_ID=pkg_40921350d3307e51491f27cb
PROTOCOL_VERSION=3

# --- policy handed to the client each response -----------------------------
HEARTBEAT_SECONDS=90
MAX_NETWORK_ERRORS=3
SESSION_TTL_SECONDS=3600
LEASE_SECONDS=300
MINIMUM_BUILD=1
SECURITY_SCHEMA=1

# --- storage ---------------------------------------------------------------
STORE_PATH=data/store.json

# --- key minting -----------------------------------------------------------
KEY_PREFIX=VT

# Optional: pin the client's payload digests server-side. Leave blank to let the
# app use its own bundled pins (recommended until you rotate the blob).
# PATCH_DIGEST=
# NEUTRAL_DIGEST=

# --- deploy (used by deploy/docker-compose.yml + deploy/Caddyfile) ----------
# Public hostname that terminates TLS. Point the DNS A record at the VPS first.
DOMAIN=auth.example.com

# --- relay listeners (src/proxy/server.ts) ---------------------------------
# Proxy listener the phone's Super Proxy / profile points at. The admin listener
# serves /login, /device, /menu, /ca.cer and /profile.mobileconfig; keep it
# behind Caddy.
# RELAY_PORT=1299
# RELAY_ADMIN_PORT=8080
# Public host printed in the profile and shown by the app. With the deploy
# script this is the DOMAIN above.
# RELAY_PUBLIC_HOST=relay.example.com
# Path prefix the reverse proxy mounts the relay under. The bundled Caddyfile
# uses `handle_path /relay/*`, which strips the prefix before forwarding, so the
# relay needs this to generate links and form actions that still include it.
# Leave empty when port 8080 is reached directly (LAN testing).
# RELAY_BASE_PATH=/relay

# --- relay tunnel (src/proxy/server.ts) ------------------------------------
# The profile can carry a VPN so the phone reaches the relay from any network,
# not just the one whose SSID was baked in. Empty RELAY_VPN_SERVER = Wi-Fi only.
# l2tp: strongswan + xl2tpd, see deploy/l2tp/setup.sh
# RELAY_VPN_MODE=l2tp
# RELAY_VPN_SERVER=
# RELAY_L2TP_USER=
# RELAY_L2TP_PASSWORD=
# RELAY_IPSEC_SECRET=

# ikev2 instead of l2tp:
# RELAY_VPN_MODE=ikev2
# RELAY_VPN_USER=
# RELAY_VPN_PASSWORD=
# RELAY_VPN_REMOTE_ID=

# Push the proxy inside the VPN payload. 0 = user types it into Wi-Fi by hand.
# RELAY_PROXY_IN_VPN=1

# Home-screen control panel. Must be an https URL the phone can reach; the
# relay serves the page itself at /menu, so this is normally the relay's host.
# Behind the bundled Caddyfile the public address includes the mount prefix:
# RELAY_MENU_URL=https://relay.example.com/relay/menu
# RELAY_MENU_LABEL=Nimbus Control

# --- relay menu login (src/proxy/server.ts) --------------------------------
# The menu and the activation portal sign in with Key + Mật khẩu + 64-hex ID.
# AUTH_URL authorises the key; AUTH_ADMIN_URL + token are used to confirm the
# session is still live without touching the heartbeat sequence the app is
# driving. Leave the token empty to keep the menu and the dashboard open (no
# login screen, no rule gating).
# AUTH_URL=http://127.0.0.1:8787/api
# AUTH_ADMIN_URL=http://127.0.0.1:8787
# AUTH_ADMIN_TOKEN=

# Override the Vietnamese install instructions iOS shows before the install.
# RELAY_CONSENT=

# --- code patch delivery through the game's own hotfix channel --------------
# COW.GameVarDef carries CodePatchUrl and InjectFixBeforeLaunchGame, and
# COW.COWGameEntry.LoadIFix applies whatever that URL returns. Pointing it at the
# relay makes the game download and install the patch itself, so nothing is
# written into its container by a second process.
#
# All four are required before the `codepatch` feature installs any rule. The
# host and the var-table path are only knowable from a real capture session:
# run the relay in capture mode, play one match, then read data/capture.jsonl
# for the response that carries the var table.
# RELAY_PATCH_HOST=patch.example.com
# RELAY_VARCONFIG_PATH=^/api/v[0-9]+/config
# RELAY_PATCH_FILE=/var/lib/ffxc-auth/Assembly-CSharp-patch.bytes
# RELAY_PATCH_PATH=/cdn/patch/Assembly-CSharp-patch.bytes
#
# Optional: serve the control document over the same channel so the patch reads
# its settings from the relay instead of a localConfig.json in Documents.
# RELAY_STATE_PATH=/api/v1/state
# RELAY_STATE_FILE=/var/lib/ffxc-auth/state.json
