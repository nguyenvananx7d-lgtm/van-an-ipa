# Copy to .env and fill in. Loaded with `node --env-file=.env`.

# --- transport -------------------------------------------------------------
HOST=0.0.0.0
PORT=8787

# Bearer token for the admin panel/REST. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me

# --- signing ---------------------------------------------------------------
# Ed25519 PKCS8 PEM produced by `npm run mint`. Keep it off the repo.
PRIVATE_KEY_PATH=keys/private.pem

# --- wire contract (must match ProtocolConstants.swift) --------------------
PRODUCT_ID=pkg_40921350d3307e51491f27cb
PROTOCOL_VERSION=3

# --- policy handed to the client each response -----------------------------
HEARTBEAT_SECONDS=90
MAX_NETWORK_ERRORS=3
SESSION_TTL_SECONDS=3600
LEASE_SECONDS=300
MINIMUM_BUILD=1
SECURITY_SCHEMA=1

# --- storage ---------------------------------------------------------------
STORE_PATH=data/store.json

# --- key minting -----------------------------------------------------------
KEY_PREFIX=VT

# Optional: pin the client's payload digests server-side. Leave blank to let the
# app use its own bundled pins (recommended until you rotate the blob).
# PATCH_DIGEST=
# NEUTRAL_DIGEST=
