# syntax=docker/dockerfile:1

# ---------- build (TypeScript -> JS) ----------
FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable
# pnpm owns the lockfile: the relay needs a runtime dependency (node-forge) and
# `npm ci` against a lock generated by npm would reject it.
COPY package.json pnpm-lock.yaml tsconfig.json ./
RUN pnpm install --frozen-lockfile
COPY src ./src
COPY scripts ./scripts
RUN pnpm run build

# ---------- runtime ----------
FROM node:20-alpine
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production
COPY package.json pnpm-lock.yaml ./
# Production dependencies only: the relay imports node-forge at runtime, so the
# old "copy dist onto a bare image" recipe would start and then crash on boot.
RUN pnpm install --frozen-lockfile --prod
COPY --from=build /app/dist ./dist
# Static control panel served at /panel (synced by scripts/sync-panel.sh).
COPY public ./public
# keys/ and data/ are bind-mounted; all config comes from the environment (.env)
EXPOSE 8787
# The relay entry point is a second process over the same image:
#   node dist/src/proxy/server.js
CMD ["node", "dist/src/server.js"]
