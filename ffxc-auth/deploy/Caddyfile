# TLS terminator in front of ffxc-auth. The iOS client posts to
# https://<DOMAIN>/api and will not accept a plaintext endpoint in practice.
#
# DOMAIN comes from the environment (.env), e.g. DOMAIN=auth.example.com
# Point the DNS A record at the VPS first; Caddy provisions the cert automatically.

{$DOMAIN} {
	encode zstd gzip

	@app path / /api /admin* /health
	handle @app {
		reverse_proxy auth:8787
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}
