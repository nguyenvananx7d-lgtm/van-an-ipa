"dns_guide" = "DNS shield guide";
"dns_guide_title" = "DNS Shield";
"dns_guide_warning" = "This encrypts DNS and can filter trackers. It does not hide your IP, does not change game traffic, and cannot guarantee an account will not be banned. Never block the game's login or matchmaking domains - that breaks the session.";
"dns_guide_what_title" = "What it does";
"dns_guide_what_1" = "Installs a system-wide DNS-over-HTTPS profile; every app, including the game, uses the chosen resolver.";
"dns_guide_what_2" = "AdGuard DNS and NextDNS filter tracker domains at the resolver; Cloudflare and Quad9 do not filter trackers.";
"dns_guide_what_3" = "No app extension or special entitlement is needed, so it works on this unsigned build.";
"dns_guide_steps_title" = "Install";
"dns_guide_step_1" = "Pick AdGuard DNS for built-in tracker blocking, or NextDNS for your own denylist.";
"dns_guide_step_2" = "For NextDNS, create a profile at nextdns.io, paste its config ID above, then copy the full blocklist from Advanced into that profile's dashboard.";
"dns_guide_step_3" = "Tap Install DNS profile. Safari opens a local page; tap Allow to download the profile.";
"dns_guide_step_4" = "Open Settings -> Profile Downloaded -> Install, then enter the passcode.";
"dns_guide_step_5" = "Return here and tap Test resolver; then confirm the game still logs in and matches normally.";
"dns_guide_verify_title" = "Verify";
"dns_guide_verify_1" = "Open dnsleaktest.com in Safari. The resolver should be the provider you chose, not your ISP.";
"dns_guide_verify_2" = "If the game cannot log in, remove the profile and reinstall it without tracker filtering.";
"dns_guide_publisher_title" = "Publisher / anti-cheat domains";
"dns_guide_publisher_1" = "NextDNS -> Logs shows every domain the game queries. Play one match, then add reporting/security names to the Denylist.";
"dns_guide_publisher_2" = "Known Free Fire security hosts: csoversea.stronghold.freefiremobile.com and gamesecurity.sea.freefiremobile.com. Blocking them can stop reporting, but may also crash the game or block login - add one at a time and test a match.";
"dns_guide_publisher_3" = "This only blocks DNS resolution. It cannot stop an in-process anti-cheat scan, a hard-coded IP, or a resolver the game runs itself.";
"dns_guide_limits_title" = "Limits and ban risk";
"dns_guide_limit_1" = "DNS filtering does not hide the egress IP. For IP privacy, run a reputable VPN and keep the same country for the whole session.";
"dns_guide_limit_2" = "Switching VPN country or IP mid-session is a stronger risk signal than a clean DNS path; connect before launching the game and stay there.";
"dns_guide_limit_3" = "Server-side telemetry and anti-cheat checks are outside this layer's reach. Treat this as hygiene, not a guarantee.";
"dns_guide_remove_title" = "Remove";
"dns_guide_remove_1" = "Settings -> General -> VPN & Device Management -> Configuration Profile -> Vortex Arena DNS Shield -> Remove Profile.";
